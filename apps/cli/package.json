{
  "name": "@agentlink/cli",
  "version": "0.10.0",
  "private": true,
  "description": "Standalone local AgentLink coding CLI",
  "license": "MIT",
  "type": "module",
  "bin": {
    "agentlink": "dist/agentlink.js"
  },
  "files": [
    "dist/agentlink.js",
    "dist/rg",
    "dist/runtime-manifest.json",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node esbuild.mjs",
    "lint": "tsc -p tsconfig.json --noEmit && oxlint src --import-plugin --report-unused-disable-directives --deny-warnings",
    "build:package": "node esbuild.mjs --package",
    "pack:private": "npm run build:package && node pack.mjs",
    "smoke:package": "node smoke-package.mjs",
    "smoke:tui": "npm run build && node smoke-tui.mjs",
    "smoke:tui:no-color": "npm run build && node smoke-tui.mjs dist/agentlink.js --no-color",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@napi-rs/keyring": "2.1.0"
  },
  "devDependencies": {
    "@agentlink/core": "0.6.1",
    "@agentlink/node-host": "0.6.1",
    "@agentlink/protocol": "0.6.1",
    "@agentlink/workspace-host": "0.6.1",
    "@types/react": "^19.3.0",
    "commander": "12.1.0",
    "ink": "7.1.1",
    "ink-picture": "2.1.0",
    "ink-testing-library": "4.0.0",
    "marked": "15.0.12",
    "react": "19.3.0",
    "react-ink-textarea": "0.4.0",
    "undici": "^8.11.2"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "optionalDependencies": {
    "@vscode/ripgrep-darwin-arm64": "1.18.0"
  }
}
