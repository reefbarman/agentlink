{
  "name": "@agentlink/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone AgentLink desktop chat",
  "license": "MIT",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node esbuild.mjs",
    "lint": "tsc -p tsconfig.json --noEmit && oxlint src --import-plugin --report-unused-disable-directives --deny-warnings",
    "package": "npm run build && node package.mjs",
    "start": "node start.mjs",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@agentlink/core": "0.1.0",
    "@agentlink/node-host": "0.1.0",
    "@agentlink/protocol": "0.1.0",
    "@napi-rs/keyring": "2.0.0"
  },
  "devDependencies": {
    "electron": "44.2.0",
    "electron-builder": "26.15.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
