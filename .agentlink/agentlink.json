{
  "version": 1,
  "agentWriteApproved": false,
  "commandRules": [
    {
      "pattern": "npm run lint",
      "mode": "prefix"
    },
    {
      "pattern": "npm test",
      "mode": "prefix"
    },
    {
      "pattern": "npm run build",
      "mode": "prefix"
    },
    {
      "pattern": "npx oxlint",
      "mode": "prefix"
    },
    {
      "pattern": "npm run fmt",
      "mode": "prefix"
    },
    {
      "pattern": "npx oxfmt",
      "mode": "prefix"
    },
    {
      "pattern": "npx @vscode/vsce ls",
      "mode": "prefix"
    },
    {
      "pattern": "npm run fmt:check",
      "mode": "prefix"
    },
    {
      "pattern": "npm run telemetry:tools",
      "mode": "prefix"
    },
    {
      "pattern": "npm run telemetry:sessions",
      "mode": "prefix",
      "decision": "allow"
    }
  ],
  "pathRules": [
    {
      "pattern": "/Users/tristan/.agentlink/",
      "mode": "prefix"
    }
  ]
}
