{
  "tasks": [
    {
      "label": "Release patch and install",
      "command": "npm run release -- --install"
    },
    {
      "label": "Release minor and install",
      "command": "npm run release -- --minor --install"
    },
    {
      "label": "Launch desktop development app",
      "command": "npm run build && npm run start --workspace @agentlink/desktop"
    },
    {
      "label": "Run tests",
      "command": "npm test"
    }
  ]
}
