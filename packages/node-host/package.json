{
  "name": "@agentlink/node-host",
  "version": "0.51.0",
  "private": true,
  "description": "Default Node.js host capabilities for AgentLink core",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist/**/*.js",
    "dist/**/*.cjs",
    "dist/**/*.d.ts",
    "dist/**/*.d.cts",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:cjs",
    "build:cjs": "node build-cjs.mjs",
    "watch": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "lint": "tsc -p tsconfig.json --noEmit && oxlint src --import-plugin --report-unused-disable-directives --deny-warnings",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@agentlink/core": "0.51.0",
    "@agentlink/protocol": "0.51.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/core": "2.4.0",
    "@napi-rs/keyring": "2.1.2",
    "@types/proxy-from-env": "1.0.4",
    "@types/ws": "8.18.2",
    "bmp-js": "^0.1.0",
    "https-proxy-agent": "9.1.0",
    "parse5": "^8.1.0",
    "picomatch": "^4.0.5",
    "pngjs": "^7.0.0",
    "proxy-from-env": "2.1.0",
    "undici": "^8.12.3",
    "unpdf": "^1.9.1",
    "ws": "8.22.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
