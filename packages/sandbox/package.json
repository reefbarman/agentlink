{
  "name": "@agentlink/sandbox",
  "version": "0.28.1",
  "private": true,
  "description": "Portable macOS command sandbox policy, helper protocol, and launcher for AgentLink hosts",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist/**/*.js",
    "dist/**/*.cjs",
    "dist/**/*.d.ts",
    "dist/**/*.d.cts",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:cjs",
    "build:cjs": "node build-cjs.mjs",
    "watch": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json && oxlint src --import-plugin --report-unused-disable-directives --deny-warnings",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@agentlink/node-host": "0.28.1",
    "@agentlink/protocol": "0.28.1",
    "picomatch": "^4.0.5"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
